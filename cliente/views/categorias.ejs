<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Altrix — Categorías</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600&family=IBM+Plex+Sans:wght@400;500&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="wrap">

    <%- include('partials/nav', { usuario, activo: 'categorias', titulo: 'Categorías' }) %>

    <% if (mensaje) { %>
        <div class="alerta <%= mensaje.tipo %>"><%= mensaje.texto %></div>
    <% } %>

    <details class="nuevo-producto">
        <summary>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
            Nueva categoría
        </summary>
        <form class="form-alta form-alta-cat" action="/categorias" method="POST">
            <div class="campo">
                <label for="nombre">Nombre</label>
                <input type="text" id="nombre" name="nombre" required>
            </div>
            <div class="campo campo-ancho">
                <label for="descripcion">Descripción (opcional)</label>
                <input type="text" id="descripcion" name="descripcion">
            </div>
            <div class="acciones-form">
                <button type="submit" class="btn btn-primary">Guardar categoría</button>
            </div>
        </form>
    </details>

    <div class="lista-header">
        <h2>Catálogo de categorías</h2>
    </div>

    <% if (categorias.length === 0) { %>
        <div class="vacio">
            <strong>Todavía no hay categorías</strong>
            Usa "Nueva categoría" arriba para agregar la primera.
        </div>
    <% } else { %>
        <% categorias.forEach(c => { %>
        <div class="producto-row">
            <div class="producto-main producto-main-cat">
                <div class="producto-nombre">
                    <span class="nombre"><%= c.nombre %></span>
                    <% if (c.descripcion) { %><span class="categoria-tag"><%= c.descripcion %></span><% } %>
                </div>
                <div></div>
                <div class="producto-acciones">
                    <button type="button" class="icon-btn toggle-panel" title="Editar" aria-label="Editar categoría">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
                    </button>
                    <form class="form-eliminar" action="/categorias/<%= c.id %>/eliminar" method="POST">
                        <button type="submit" class="icon-btn danger" title="Eliminar" aria-label="Eliminar categoría">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/></svg>
                        </button>
                    </form>
                </div>
            </div>
            <div class="panel-secundario un-bloque">
                <div class="bloque">
                    <h3>Modificar</h3>
                    <form class="form-inline" action="/categorias/<%= c.id %>" method="POST">
                        <input type="text" name="nombre" value="<%= c.nombre %>" required>
                        <input type="text" name="descripcion" value="<%= c.descripcion || '' %>" placeholder="Descripción">
                        <button type="submit" class="btn btn-ghost">Guardar</button>
                    </form>
                </div>
            </div>
        </div>
        <% }) %>
    <% } %>

</div>
<script src="/js/app.js"></script>
</body>
</html>
